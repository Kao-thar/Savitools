{
  "name": "savitools",
  "version": "0.1.0",
  "homepage": "https://savitools.savitura.com",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node init && turbo dev",
    "build": "node init && turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:openapi": "npm run test:openapi --workspace @savitools/api",
    "specs:generate": "node scripts/generate-sdk-specs.mjs",
    "specs:check": "node scripts/generate-sdk-specs.mjs --check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "smoke:playground": "node scripts/check-playground-hosts.mjs",
    "seed": "docker compose -f docker-compose.dev.yml exec -T api sh -c \"npx ts-node scripts/seed.ts\"",
    "sbom": "cyclonedx-bom -o dist/sbom/cyclonedx.json"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "cyclonedx-bom": "^0.0.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@hexagon/base64": "1.1.27",
    "@peculiar/asn1-rsa": "^2.9.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
